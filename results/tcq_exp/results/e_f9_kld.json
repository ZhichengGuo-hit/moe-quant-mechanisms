   "llama.cpp/tools/server/README.md"
  ],
  "logits_all": false,
  "logits_all_note": "grep 'logits-all|logits_all|--logits' 在 tools/server 下无命中; 该 fork 没有返回全词表 logits 的选项, 只有 n_probs 的 top-k",
  "max_top_k": "无显式上限 (schema 只要求 >0); 实际上限是候选向量长度/词表大小, 默认 0 表示不返回",
  "request_field": "n_probs (别名 logprobs); OAI chat 侧要求 logprobs=true 且用 top_logprobs",
  "response_shape": {
   "path": "completion_probabilities[i]  (i = 第 i 个生成 token, 长度 n_predict)",
   "entry": {
    "id": "token id",
    "token": "str",
    "bytes": "list[int]",
    "logprob": "ln p (post_sampling_probs=false)",
    "top_logprobs": "[{id, token, bytes, logprob}]"
   },
   "note": "post_sampling_probs=true 时字段改为 prob/top_probs (经过采样链, 不是原始分布)"
  },
  "probability_semantics": "get_token_probabilities() 对整条候选向量做 softmax (server-common.cpp:1664-1711, cum_sum 覆盖全部 cur), 返回的 top-k 概率是绝对概率; tail 桶 = 1 - sum(top-k) 可直接用于 KLD",
  "pre_sampling_logits": "n_probs>0 且 post_sampling_probs=false 时 need_pre_sample_logits 置位并关闭 backend sampling (server-context.cpp:2127), 概率来自原始 logits, 与 temperature/top_k 无关",
  "n_predict_1": "支持; 每个请求只产出 1 个位置的分布, 配合 token 前缀实现逐点 teacher forcing",
  "prompt_token_ids": "server-common.cpp tokenize_mixed(): \"prompt\": [12,34,...] 直接按 id 使用, 数字数组不加 BOS",
  "cache_prompt": "支持 true/false; 默认 true, 前缀复用与 false 数学等价",
  "tokenize_endpoint": "/tokenize (content/add_special=false/parse_special=true), 用于严格对齐 token",
  "context": "tcmoe 补丁: /completion 的 \"domain\" 字段选择专家补丁, 缺省 = 首个声明的域; 非 tcmoe 模型忽略该字段 (server-context.cpp resolve_tcmoe_domain)",
  "runtime_probe": "未做 (机器上有 12h UD 评测队列在跑, 再起 server 会污染其耗时)"
