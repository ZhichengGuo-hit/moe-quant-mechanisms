{
 "protocol": {
  "experiment": "E-F9 token-level output-distribution KLD (quantized vs full-precision)",
  "claim": "KLD 是否携带任务级信号: KLD-NLL-acc 三层对应",
  "corpus": "data/{domain}_eval64.jsonl, 每域前 16 条, 每条前 64 个位置",
  "alignment": "逐位置提交 prompt=ids[:i] + n_predict=1, 取该位置下一个 token 的 top-k",
  "metrics": [
   "KLD(P_ref||Q_model)",
   "JSD(nats)",
   "top1_agree",
   "NLL_ref",
   "NLL_model(teacher-forcing, top-k 覆盖或 tail 分摊)"
  ],
  "kld_method": "两侧 top-k 并到同一支撑; 对侧未出现的 token 用该侧剩余质量均匀分摊, 剩余进 __tail__ 桶; p=0 项跳过, q<=0 时 clamp 1e-12",
  "mass_sanity": "top-k 概率应为全词表 softmax 的绝对值 (mass<1, 随 k 增大上升); 若 mean_topk_mass 恒等于 1.000, 说明被候选内归一, 本次结果作废",
  "k": 20,
  "domains": [
   "math",
   "code",
   "general"
  ],
  "seqs": 16,
  "ctx_tokens": 64,
  "threads": 16,
  "cache_prompt": true,
  "n_ctx": 128,
  "port": 18095,
  "backend": "CPU only (build-tcmoe, type45 tcmoe patches); 无 CUDA 设备",
  "llama_cpp_commit": "5047748f114564fcf271e6a648f60e2d2eae6264 2026-10-30 20:36:30 +0100",
