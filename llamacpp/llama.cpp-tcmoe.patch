diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
index 21cd631..3d307bb 100644
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -762,6 +762,192 @@ void ggml_vec_dot_q2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const voi
 #endif
 }
 
+#if defined(__AVX2__)
+// tcmoe_q2 packs 128 weights into one block; every 8-byte group is one 32-value Q8_0 sub-block,
+// and each byte holds four consecutive 2-bit fields (field k sits at bit 2k of its byte)
+static inline __m256i tcmoe_q2_unpack_32_avx2(const uint8_t * qs) {
+    __m256i v = _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) qs));
+    v = _mm256_or_si256(v, _mm256_slli_epi32(v, 12));
+    v = _mm256_or_si256(v, _mm256_slli_epi32(v,  6));
+    return _mm256_and_si256(v, _mm256_set1_epi32(0x03030303));
+}
+
+// 32 weights against one Q8_0 block: sum((2q - 3) * y), exact in int32; the caller folds in 0.5 * d_x * d_y
+static inline __m256 tcmoe_q2_dot_32_avx2(const uint8_t * qs, const int8_t * qy) {
+    const __m256i v = tcmoe_q2_unpack_32_avx2(qs);
+    // q in [0,3] -> 2q-3 in [-3,3]; (q - 1.5) = (2q - 3) / 2
+    const __m256i s = _mm256_sub_epi8(_mm256_slli_epi16(v, 1), _mm256_set1_epi8(3));
+    const __m256i y = _mm256_loadu_si256((const __m256i *) qy);
+    return sum_i16_pairs_float(mul_add_epi8(s, y));
+}
+
+static inline __m256 tcmoe_q2_acc_block_avx2(const block_tcmoe_q2 * x, const block_q8_0 * y, __m256 acc) {
+    const float dx = 0.5f * GGML_CPU_FP16_TO_FP32(x->d);
+    for (int k = 0; k < 4; ++k) {
+        const __m256 d = _mm256_set1_ps(dx * GGML_CPU_FP16_TO_FP32(y[k].d));
+        const __m256 p = tcmoe_q2_dot_32_avx2(x->qs + 8 * k, y[k].qs);
+#if defined(__FMA__)
+        acc = _mm256_fmadd_ps(d, p, acc);
+#else
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(d, p));
+#endif
+    }
+    return acc;
+}
+#endif
+
+void ggml_vec_dot_tcmoe_q2_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK_TCMOE_Q2;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+#if defined(__AVX2__)
+    const block_tcmoe_q2 * GGML_RESTRICT x = vx;
+    const block_q8_0     * GGML_RESTRICT y = vy;
+
+    // two blocks per step, each into its own FMA chain
+    __m256 acc0 = _mm256_setzero_ps();
+    __m256 acc1 = _mm256_setzero_ps();
+
+    int i = 0;
+    for (; i + 1 < nb; i += 2) {
+        acc0 = tcmoe_q2_acc_block_avx2(x + i + 0, y + 4*(i + 0), acc0);
+        acc1 = tcmoe_q2_acc_block_avx2(x + i + 1, y + 4*(i + 1), acc1);
+    }
+    if (i < nb) {
+        acc0 = tcmoe_q2_acc_block_avx2(x + i, y + 4*i, acc0);
+    }
+
+    *s = hsum_float_8(_mm256_add_ps(acc0, acc1));
+#else
+    ggml_vec_dot_tcmoe_q2_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
+
+#if defined(__AVX2__)
+// tcmoe_q2nl: code k decodes to cb[k] * d. The 4-entry codebook is int8-normalized so one
+// vpshufb maps all 32 codes of a sub-block at once, which keeps the op count of tcmoe_q2.
+static inline __m256 tcmoe_q2nl_dot_32_avx2(const uint8_t * qs, const int8_t * qy, __m256i lut) {
+    const __m256i v = tcmoe_q2_unpack_32_avx2(qs);
+    const __m256i w = _mm256_shuffle_epi8(lut, v);
+    const __m256i y = _mm256_loadu_si256((const __m256i *) qy);
+    return sum_i16_pairs_float(mul_add_epi8(w, y));
+}
+
+static inline __m256 tcmoe_q2nl_acc_block_avx2(const block_tcmoe_q2nl * x, const block_q8_0 * y,
+        __m256 acc, __m256i lut, float cb_scale) {
+    const float dx = GGML_CPU_FP16_TO_FP32(x->d) * cb_scale;
+    for (int k = 0; k < 4; ++k) {
+        const __m256 d = _mm256_set1_ps(dx * GGML_CPU_FP16_TO_FP32(y[k].d));
+        const __m256 p = tcmoe_q2nl_dot_32_avx2(x->qs + 8 * k, y[k].qs, lut);
+#if defined(__FMA__)
+        acc = _mm256_fmadd_ps(d, p, acc);
+#else
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(d, p));
+#endif
+    }
+    return acc;
+}
+
+// alternative: look the codebook up as floats with vpermps. Kept for the A/B timing only
+// (GGML_TCMOE_Q2NL_FP32=1); it needs twice the instructions of the int8 table.
+static inline __m256 tcmoe_q2nl_acc_block_fp32_avx2(const block_tcmoe_q2nl * x, const block_q8_0 * y,
+        __m256 acc, __m256 cbv) {
+    const float dx = GGML_CPU_FP16_TO_FP32(x->d);
+    for (int k = 0; k < 4; ++k) {
+        const uint8_t * qs = x->qs + 8 * k;
+        const int8_t  * qy = y[k].qs;
+        const float dy = dx * GGML_CPU_FP16_TO_FP32(y[k].d);
+
+        __m256i v = tcmoe_q2_unpack_32_avx2(qs);
+
+        const __m128i lo = _mm256_castsi256_si128(v);
+        const __m128i hi = _mm256_extracti128_si256(v, 1);
+
+        __m256 partial = _mm256_setzero_ps();
+        for (int h = 0; h < 4; ++h) {
+            const __m128i ib = (h < 2) ? lo : hi;
+            const __m128i idx128 = (h % 2 == 0) ? ib : _mm_srli_si128(ib, 8);
+            const __m128i yb = _mm_loadl_epi64((const __m128i *) (qy + 8 * h));
+            const __m256i idx = _mm256_cvtepu8_epi32(idx128);
+            const __m256 w = _mm256_permutevar8x32_ps(cbv, idx);
+            const __m256 yf = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(yb));
+            partial = _mm256_add_ps(partial, _mm256_mul_ps(w, yf));
+        }
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(_mm256_set1_ps(dy), partial));
+    }
+    return acc;
+}
