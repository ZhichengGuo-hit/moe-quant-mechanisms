+// ggml_compute_forward_mul_mat_id_mixed
+//
+// Same result as mul_mat_id(base) + mul_mat_id(patch) + add, in a single node: both id
+// tables are grouped before a single barrier and the two expert loops write the result
+// directly. That removes one threadpool dispatch, one extra pass over the result and the
+// add, without touching the dot kernels of either type
+
+// quantizes src1 into wdata for one vec_dot type, the layout matches ggml_compute_forward_mul_mat_id
+static void ggml_mmid_quantize_src1(const struct ggml_tensor * src1, enum ggml_type vec_dot_type,
+        char * wdata, int ith, int nth) {
+    ggml_from_float_t const from_float = type_traits_cpu[vec_dot_type].from_float;
+
+    const size_t nbw0 = ggml_type_size(vec_dot_type);
+    const size_t nbw1 = ggml_row_size(vec_dot_type, src1->ne[0]);
+    const size_t nbw2 = nbw1*src1->ne[1];
+    const size_t nbw3 = nbw2*src1->ne[2];
+
+    const size_t bs = ggml_blck_size(vec_dot_type);
+
+    for (int64_t i13 = 0; i13 < src1->ne[3]; ++i13) {
+        for (int64_t i12 = 0; i12 < src1->ne[2]; ++i12) {
+            for (int64_t i11 = 0; i11 < src1->ne[1]; ++i11) {
+                const int64_t b0 = (ith * src1->ne[0]/bs) / nth;
+                const int64_t b1 = ((ith + 1) * src1->ne[0]/bs) / nth;
+                from_float((float *) ((char *) src1->data + i13*src1->nb[3] + i12*src1->nb[2] +
+                            i11*src1->nb[1] + b0*bs*src1->nb[0]),
+                           (void *) (wdata + i13*nbw3 + i12*nbw2 + i11*nbw1 + b0*nbw0),
+                           (b1 - b0) * bs);
+            }
+        }
+    }
+}
