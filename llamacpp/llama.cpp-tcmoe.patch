+// the expert loop of one weight tensor; the tiled kernel reads dst->src[0] as its weights,
+// so it is only offered to the base pair
+static void ggml_compute_forward_mul_mat_id_pair(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst,
+        const struct ggml_tensor * src0,
+        const struct ggml_tensor * ids,
+        const int64_t * matrix_row_counts,
+        const struct mmid_row_mapping * matrix_rows,
+        char * atomic_current_chunk,
+        const void * wdata,
+        char * tiled_scratch,
+        const bool allow_tiled) {
+
+    const struct ggml_tensor * src1 = dst->src[1];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const enum ggml_type type         = src0->type;
+    const enum ggml_type vec_dot_type = type_traits_cpu[type].vec_dot_type;
+
+    const bool src1_cont = ggml_is_contiguous(src1);
+
+    const int64_t n_as = ne02;
+
+    for (int cur_a = 0; cur_a < n_as; ++cur_a) {
+        const int64_t cne1 = matrix_row_counts[cur_a];
+
+        if (cne1 == 0) {
+            continue;
+        }
+
+        if (allow_tiled &&
+            ggml_compute_forward_mul_mat_id_tiled(params, dst, cur_a, cne1,
+                (const int32_t *) &matrix_rows[cur_a*ids->ne[0]*ids->ne[1]], tiled_scratch)) {
+            continue;
+        }
+
+        const char * src0_cur = (const char *) src0->data + cur_a * nb02;
+        const size_t row_size = ggml_row_size(vec_dot_type, ne10);
+
+        const int64_t nr0 = ne01;
+        const int64_t nr1 = cne1;
+
+        int chunk_size = 16;
+        if (nr0 == 1 || nr1 == 1) {
+            chunk_size = 64;
+        }
+
+        // disable for NUMA
+        const bool disable_chunking = ggml_is_numa();
+
+        int64_t nchunk0 = (nr0 + chunk_size - 1) / chunk_size;
+        int64_t nchunk1 = (nr1 + chunk_size - 1) / chunk_size;
+
+        if (nchunk0 * nchunk1 < nth * 4 || disable_chunking) {
+            nchunk0 = nr0 > nr1 ? nth : 1;
+            nchunk1 = nr0 > nr1 ? 1 : nth;
+        }
+
+        const int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+        const int64_t dr1 = (nr1 + nchunk1 - 1) / nchunk1;
+
+        int current_chunk = ith;
+
+        atomic_int * current_chunk_ctr = (atomic_int *) (atomic_current_chunk + (size_t) cur_a*CACHE_LINE_SIZE);
+
+        while (current_chunk < nchunk0 * nchunk1) {
+            const int64_t ith0 = current_chunk % nchunk0;
+            const int64_t ith1 = current_chunk / nchunk0;
+
+            const int64_t ir0_start = dr0 * ith0;
+            const int64_t ir0_end = MIN(ir0_start + dr0, nr0);
+
+            const int64_t ir1_start = dr1 * ith1;
+            const int64_t ir1_end = MIN(ir1_start + dr1, nr1);
+
+            ggml_compute_forward_mul_mat_id_one_chunk(
+                dst, src0, src1, ids, cur_a,
+                ir0_start, ir0_end, ir1_start, ir1_end,
+                src0_cur, matrix_rows, row_size, src1_cont, wdata
+            );
+
+            if (nth >= nchunk0 * nchunk1) {
+                break;
+            }
+
+            current_chunk = atomic_fetch_add_explicit(current_chunk_ctr, 1, memory_order_relaxed);
+        }
+    }
+}
+
+static void ggml_compute_forward_mul_mat_id_mixed(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * src0  = dst->src[0]; // base experts
+    const struct ggml_tensor * src1  = dst->src[1];
+    const struct ggml_tensor * ids   = dst->src[2];
+    const struct ggml_tensor * src0b = dst->src[3]; // patch experts
+    const struct ggml_tensor * idsb  = dst->src[4];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    GGML_ASSERT(nb00 == ggml_type_size(src0->type));
+    GGML_ASSERT(nb10 == ggml_type_size(src1->type));
+
+    // dst cannot be transposed or permuted
+    GGML_ASSERT(nb0 == sizeof(float));
+    GGML_ASSERT(nb0 <= nb1);
+    GGML_ASSERT(nb1 <= nb2);
+    GGML_ASSERT(nb2 <= nb3);
+
+    const int n_ids = ids->ne[0]; // n_expert_used
+    const int n_as  = ne02;       // n_expert of the base tensor
+    const int n_asb = src0b->ne[2];
+
+    const enum ggml_type vdt_a = type_traits_cpu[src0 ->type].vec_dot_type;
+    const enum ggml_type vdt_b = type_traits_cpu[src0b->type].vec_dot_type;
+
+    const bool quant_a = src1->type != vdt_a;
+    const bool quant_b = src1->type != vdt_b;
+
+    void * wdata_cur = params->wdata;
+
+    char * wdata_a = NULL;
+    char * wdata_b = NULL;
+    if (quant_a) {
+        wdata_a = incr_ptr_aligned(&wdata_cur, ggml_row_size(vdt_a, ggml_nelements(src1)), sizeof(int64_t));
+    }
+    if (quant_b) {
+        wdata_b = incr_ptr_aligned(&wdata_cur, ggml_row_size(vdt_b, ggml_nelements(src1)), sizeof(int64_t));
+    }
+
+    int64_t * matrix_row_counts_a = incr_ptr_aligned(&wdata_cur, n_as*sizeof(int64_t), sizeof(int64_t));
+    struct mmid_row_mapping * matrix_rows_a = incr_ptr_aligned(&wdata_cur,
+            n_as*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping), sizeof(int64_t));
+    char * atomic_current_chunk_a = incr_ptr_aligned(&wdata_cur, CACHE_LINE_SIZE*n_as, CACHE_LINE_SIZE);
+
+    int64_t * matrix_row_counts_b = incr_ptr_aligned(&wdata_cur, n_asb*sizeof(int64_t), sizeof(int64_t));
+    struct mmid_row_mapping * matrix_rows_b = incr_ptr_aligned(&wdata_cur,
+            n_asb*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping), sizeof(int64_t));
+    char * atomic_current_chunk_b = incr_ptr_aligned(&wdata_cur, CACHE_LINE_SIZE*n_asb, CACHE_LINE_SIZE);
+
+    char * tiled_scratch = incr_ptr_aligned(&wdata_cur, ggml_tiled_wdata_size(nth, dst), 64);
+
+    GGML_ASSERT(params->wsize >= (size_t)((char *) wdata_cur - (char *) params->wdata));
+
+    if (quant_a) {
+        ggml_mmid_quantize_src1(src1, vdt_a, wdata_a, ith, nth);
+    }
+    if (quant_b) {
+        ggml_mmid_quantize_src1(src1, vdt_b, wdata_b, ith, nth);
+    }
+
+    if (ith == 0) {
+        memset(matrix_row_counts_a, 0, n_as *sizeof(int64_t));
+        memset(matrix_row_counts_b, 0, n_asb*sizeof(int64_t));
+
+        for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+            for (int id = 0; id < n_ids; ++id) {
+                const int32_t i02a = *(const int32_t *) ((const char *) ids ->data + iid1*ids ->nb[1] + id*ids ->nb[0]);
+                const int32_t i02b = *(const int32_t *) ((const char *) idsb->data + iid1*idsb->nb[1] + id*idsb->nb[0]);
+
+                GGML_ASSERT(i02a == -1 || (i02a >= 0 && i02a < n_as));
+                GGML_ASSERT(i02b == -1 || (i02b >= 0 && i02b < n_asb));
+                // a slot is owned by exactly one of the two tables
+                GGML_ASSERT(i02a < 0 || i02b < 0);
+
+                if (i02a < 0 && i02b < 0) {
+                    memset((char *) dst->data + id*nb1 + iid1*nb2, 0, ne0*sizeof(float));
+                    continue;
+                }
+
+                if (i02a >= 0) {
+                    matrix_rows_a[i02a*ids->ne[0]*ids->ne[1] + matrix_row_counts_a[i02a]] =
+                        (struct mmid_row_mapping) { id, (int32_t) iid1 };
+                    matrix_row_counts_a[i02a] += 1;
+                } else {
+                    matrix_rows_b[i02b*ids->ne[0]*ids->ne[1] + matrix_row_counts_b[i02b]] =
+                        (struct mmid_row_mapping) { id, (int32_t) iid1 };
+                    matrix_row_counts_b[i02b] += 1;
+                }
+            }
+        }
+    }
+
+    // reset current_chunk
+    for (int cur_a = ith; cur_a < n_as; cur_a += nth) {
+        *(atomic_int *) (atomic_current_chunk_a + (size_t) cur_a*CACHE_LINE_SIZE) = nth;
+    }
+    for (int cur_a = ith; cur_a < n_asb; cur_a += nth) {
+        *(atomic_int *) (atomic_current_chunk_b + (size_t) cur_a*CACHE_LINE_SIZE) = nth;
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // the base experts first; a thread that runs out of base chunks continues into the patch
+    // experts right away, so the two loops share one tail instead of adding a second one
+    ggml_compute_forward_mul_mat_id_pair(params, dst, src0, ids, matrix_row_counts_a, matrix_rows_a,
+            atomic_current_chunk_a, quant_a ? wdata_a : src1->data, tiled_scratch, true);
+
+    ggml_compute_forward_mul_mat_id_pair(params, dst, src0b, idsb, matrix_row_counts_b, matrix_rows_b,
+            atomic_current_chunk_b, quant_b ? wdata_b : src1->data, tiled_scratch, false);
+}
