+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_tcmoe_q2 * GGML_RESTRICT x = vx;
+    const block_q8_0     * GGML_RESTRICT y = vy;
+
+    float sumf = 0.0f;
+
+    // one tcmoe_q2 block (128 weights) spans four Q8_0 blocks (4 * 32)
+    for (int i = 0; i < nb; i++) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+
+        float sumi = 0.0f;
+
+        for (int j = 0; j < 4; j++) {
+            const block_q8_0 * GGML_RESTRICT yb = &y[4*i + j];
+            const float d1 = GGML_CPU_FP16_TO_FP32(yb->d);
+
+            const uint8_t * GGML_RESTRICT qs = &x[i].qs[j * 8];
+            const int8_t  * GGML_RESTRICT qy = yb->qs;
+
+            int sumi_2q = 0;
+
+            for (int k = 0; k < 32; ++k) {
+                const int q = (qs[k >> 2] >> ((k & 3) * 2)) & 0x03;
