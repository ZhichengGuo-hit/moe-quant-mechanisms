+void dequantize_row_tcmoe_q2(const block_tcmoe_q2 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    static const int qk = QK_TCMOE_Q2;
+
+    assert(k % qk == 0);
+
+    const int nb = k / qk;
+
+    for (int i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d);
+
+        for (int j = 0; j < qk; ++j) {
+            const int byte_index = j / 4;
+            const int bit_offset = (j % 4) * 2;
+            const uint8_t q = (x[i].qs[byte_index] >> bit_offset) & 0x03;
+            // 00=-1.5, 01=-0.5, 10=+0.5, 11=+1.5 (multiples of d)
+            y[i*qk + j] = ((float) q - 1.5f) * d;
+        }
+    }
+}
+
+void quantize_row_tcmoe_q2_ref(const float * GGML_RESTRICT x, block_tcmoe_q2 * GGML_RESTRICT y, int64_t k) {
+    static const int qk = QK_TCMOE_Q2;
+
+    assert(k % qk == 0);
+
+    const int nb = k / qk;
+
+    for (int i = 0; i < nb; i++) {
+        float amax = 0.0f;
+        for (int j = 0; j < qk; j++) {
+            const float a = fabsf(x[i*qk + j]);
+            if (a > amax) amax = a;
+        }
+        const float d = amax / 1.5f;
+        const float id = d > 0.0f ? 1.0f / d : 0.0f;
+
+        y[i].d = GGML_FP32_TO_FP16(d);
+
+        for (int j = 0; j < qk / 4; ++j) {
+            y[i].qs[j] = 0;
+        }
+
+        for (int j = 0; j < qk; ++j) {
+            int q = (int) roundf(x[i*qk + j] * id + 1.5f);
+            if (q < 0) q = 0;
+            if (q > 3) q = 3;
+            const int byte_index = j / 4;
+            const int bit_offset = (j % 4) * 2;
+            y[i].qs[byte_index] |= (uint8_t) q << bit_offset;
+        }
+    }
+}
