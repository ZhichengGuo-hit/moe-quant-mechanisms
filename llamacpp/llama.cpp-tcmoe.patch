+// map the per-domain expert patches into the layers: the patch weights stay in the file, the
+// expert id tables that the MoE branch needs are built on the host
+bool llama_model_base::load_tensors_tcmoe(llama_model_loader & ml) {
+    const int64_t kid = gguf_find_key(ml.metadata, "tcmoe.enabled");
+    if (kid < 0 || gguf_get_kv_type(ml.metadata, kid) != GGUF_TYPE_BOOL || !gguf_get_val_bool(ml.metadata, kid)) {
+        return true;
+    }
+    if (ml.no_alloc) {
+        return true;
+    }
+    if (!ml.use_mmap) {
+        throw std::runtime_error("tcmoe models require mmap");
+    }
+
+    std::vector<std::string> domains;
+    if (!ml.get_arr("tcmoe.domains", domains, true) || domains.empty()) {
+        throw std::runtime_error("tcmoe: tcmoe.domains is missing or empty");
+    }
+
+    const int n_domain = (int) domains.size();
+    const int n_layer  = hparams.n_layer();
+
+    // E21: optional 4-entry codebooks of a tcmoe_q2nl base, layer-major with gate, up, down
+    const int64_t kid_cb = gguf_find_key(ml.metadata, "tcmoe.cb");
+    if (kid_cb >= 0) {
+        if (gguf_get_kv_type(ml.metadata, kid_cb) != GGUF_TYPE_ARRAY) {
+            throw std::runtime_error("tcmoe: tcmoe.cb must be an array");
+        }
+        if (gguf_get_arr_type(ml.metadata, kid_cb) != GGUF_TYPE_FLOAT32) {
+            throw std::runtime_error("tcmoe: tcmoe.cb must hold float32 values");
+        }
+        const size_t n_cb = gguf_get_arr_n(ml.metadata, kid_cb);
+        if (n_cb != (size_t) n_layer * 3 * 4) {
+            throw std::runtime_error(format("tcmoe: tcmoe.cb has %zu values, expected %d", n_cb, n_layer * 12));
+        }
+        const float * cb = (const float *) gguf_get_arr_data(ml.metadata, kid_cb);
+        pimpl->tcmoe_cb_data.assign(cb, cb + n_cb);
+    }
+
+    struct layer_dom {
+        const llama_model_loader::llama_tensor_weight * idx  = nullptr;
+        const llama_model_loader::llama_tensor_weight * gate = nullptr;
+        const llama_model_loader::llama_tensor_weight * up   = nullptr;
+        const llama_model_loader::llama_tensor_weight * down = nullptr;
+    };
+
+    std::vector<layer_dom> ld((size_t) n_layer * n_domain);
+
+    for (const auto & kv : ml.weights_map) {
+        int         layer  = -1;
+        int         domain = -1;
+        std::string what;
+        if (!tcmoe_parse_name(kv.first.c_str(), layer, what, domain)) {
+            continue;
+        }
+        if (layer >= n_layer) {
+            throw std::runtime_error(format("tcmoe: tensor %s belongs to a layer outside the trunk", kv.first.c_str()));
+        }
+        if (domain < 0 || domain >= n_domain) {
+            throw std::runtime_error(format("tcmoe: tensor %s uses a domain that is not declared", kv.first.c_str()));
+        }
+
+        layer_dom & e = ld[(size_t) layer * n_domain + domain];
+        if (what == "idx") {
+            e.idx = &kv.second;
+            continue;
+        }
+
+        switch (tcmoe_proj_from_name(what)) {
+            case TCMOE_PROJ_GATE: e.gate = &kv.second; break;
+            case TCMOE_PROJ_UP:   e.up   = &kv.second; break;
+            case TCMOE_PROJ_DOWN: e.down = &kv.second; break;
+            default:
+                throw std::runtime_error(format("tcmoe: unsupported patch tensor %s", kv.first.c_str()));
+        }
+    }
+
+    size_t n_patch = 0;
+    size_t n_table = 0;
+    for (const auto & e : ld) {
+        const bool full = e.idx && e.gate && e.up && e.down;
+        n_patch += full ? 3 : 0;
+        n_table += full ? 2 : 0;
+    }
+    if (n_patch == 0) {
+        return true;
+    }
+
+    ggml_init_params ip = {
+        /*.mem_size   =*/ ggml_tensor_overhead() * (n_patch + n_table + 8),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+
+    ggml_context_ptr ctx_patch(ggml_init(ip));
+    ggml_context_ptr ctx_ids  (ggml_init(ip));
+    if (!ctx_patch || !ctx_ids) {
+        throw std::runtime_error("tcmoe: failed to create the tensor contexts");
+    }
+
+    // the loader releases the file regions that none of its contexts wraps, so the patches get
+    // their own mappings; the pages stay shared with the ones of the loader through the page cache
+    for (uint32_t idx = 0; idx < ml.files.size(); ++idx) {
+        pimpl->tcmoe_mappings.emplace_back(new llama_mmap(ml.files[idx].get(), 0, false));
+    }
+
+    std::vector<ggml_backend_buffer_ptr> bufs_patch;
+
+    std::vector<ggml_backend_buffer_t> file_bufs(ml.files.size(), nullptr);
+    for (uint32_t idx = 0; idx < ml.files.size(); ++idx) {
+        const llama_mmap * map = pimpl->tcmoe_mappings.at(idx).get();
+        ggml_backend_buffer_t buf = ggml_backend_cpu_buffer_from_ptr(map->addr(), map->size());
+        if (buf == nullptr) {
+            throw std::runtime_error("tcmoe: failed to wrap the mapped file");
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        file_bufs[idx] = buf;
+        bufs_patch.emplace_back(buf);
+    }
+
+    const auto make_patch = [&](const llama_model_loader::llama_tensor_weight * w) -> ggml_tensor * {
+        ggml_tensor * meta = w->tensor;
+        if (meta->type != GGML_TYPE_Q4_0 && meta->type != GGML_TYPE_Q4_K) {
+            throw std::runtime_error(format("tcmoe: patch tensor %s is neither q4_0 nor q4_k", meta->name));
+        }
+        ggml_tensor * t = ggml_new_tensor(ctx_patch.get(), meta->type, ggml_n_dims(meta), meta->ne);
+        ggml_set_name(t, meta->name);
+
+        void * addr = (char *) pimpl->tcmoe_mappings.at(w->idx)->addr() + w->offs;
+        if ((uintptr_t) addr % 16 != 0) {
+            throw std::runtime_error(format("tcmoe: patch tensor %s is not 16-byte aligned", meta->name));
+        }
+        if (ggml_backend_tensor_alloc(file_bufs.at(w->idx), t, addr) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error(format("tcmoe: failed to bind patch tensor %s", meta->name));
+        }
+        return t;
+    };
+
+    for (int l = 0; l < n_layer; ++l) {
+        for (int d = 0; d < n_domain; ++d) {
+            const layer_dom & e = ld[(size_t) l * n_domain + d];
+            if (!e.idx || !e.gate || !e.up || !e.down) {
+                continue;
+            }
+
+            auto & tc = layers[l].tcmoe;
+            const size_t n = (size_t) d;
+            if (tc.ids_base.empty()) {
+                const size_t n_domain_ = (size_t) n_domain;
+                tc.gate_exps .assign(n_domain_, nullptr);
+                tc.up_exps   .assign(n_domain_, nullptr);
+                tc.down_exps .assign(n_domain_, nullptr);
+                tc.ids_base  .assign(n_domain_, nullptr);
+                tc.ids_patch .assign(n_domain_, nullptr);
+            }
+
+            tc.gate_exps[n] = make_patch(e.gate);
+            tc.up_exps  [n] = make_patch(e.up);
+            tc.down_exps[n] = make_patch(e.down);
+
+            ggml_tensor * base_exps = layers[l].ffn_down_exps;
+            if (base_exps == nullptr) {
+                throw std::runtime_error(format("tcmoe: layer %d has patches but no routed experts", l));
+            }
+            const int64_t n_expert = base_exps->ne[2];
+            const int64_t n_patch_d = e.idx->tensor->ne[0];
+            if (n_patch_d <= 0 || tc.gate_exps[n]->ne[2] != n_patch_d) {
+                throw std::runtime_error(format("tcmoe: layer %d domain %d: patch count mismatch", l, d));
+            }
+
+            tc.ids_base [n] = ggml_new_tensor_1d(ctx_ids.get(), GGML_TYPE_I32, n_expert);
+            tc.ids_patch[n] = ggml_new_tensor_1d(ctx_ids.get(), GGML_TYPE_I32, n_expert);
+            ggml_set_name(tc.ids_base [n], format("blk.%d.tcmoe.ids_base.%d",  l, d).c_str());
+            ggml_set_name(tc.ids_patch[n], format("blk.%d.tcmoe.ids_patch.%d", l, d).c_str());
+        }
+    }
+
+    ggml_backend_buffer_t buf_ids = ggml_backend_alloc_ctx_tensors_from_buft(ctx_ids.get(), ggml_backend_cpu_buffer_type());
+    if (buf_ids == nullptr) {
+        throw std::runtime_error("tcmoe: failed to allocate the expert id tables");
+    }
+
+    for (int l = 0; l < n_layer; ++l) {
+        for (int d = 0; d < n_domain; ++d) {
+            const layer_dom & e = ld[(size_t) l * n_domain + d];
+            if (!e.idx || !layers[l].tcmoe.any() || layers[l].tcmoe.ids_base[(size_t) d] == nullptr) {
+                continue;
+            }
+
+            const int64_t n_expert = layers[l].ffn_down_exps->ne[2];
+            const int64_t n_patch_d = e.idx->tensor->ne[0];
+            const int32_t * idx_data = (const int32_t *) ((const char *) pimpl->tcmoe_mappings.at(e.idx->idx)->addr() + e.idx->offs);
+
+            std::vector<int32_t> base(n_expert);
+            std::vector<int32_t> patch(n_expert, -1);
+            for (int64_t k = 0; k < n_expert; ++k) {
+                base[k] = (int32_t) k;
+            }
+            for (int64_t k = 0; k < n_patch_d; ++k) {
+                const int32_t ex = idx_data[k];
+                if (ex < 0 || ex >= n_expert) {
+                    throw std::runtime_error(format("tcmoe: layer %d domain %d: expert id %d out of range", l, d, ex));
+                }
+                base [ex] = -1;
+                patch[ex] = (int32_t) k;
+            }
+
+            const size_t n = (size_t) d;
+            ggml_backend_tensor_set(layers[l].tcmoe.ids_base [n], base .data(), 0, base .size() * sizeof(int32_t));
+            ggml_backend_tensor_set(layers[l].tcmoe.ids_patch[n], patch.data(), 0, patch.size() * sizeof(int32_t));
+        }
+    }
+
+    pimpl->ctxs_bufs.emplace_back(std::move(ctx_patch), std::move(bufs_patch));
+    {
+        std::vector<ggml_backend_buffer_ptr> b;
+        b.emplace_back(buf_ids);
+        pimpl->ctxs_bufs.emplace_back(std::move(ctx_ids), std::move(b));
+    }
+
+    // attach the codebooks to the base expert tensors; the CPU dot kernels read them from
+    // ggml_tensor.extra (see ggml_cpu_tcmoe_q2nl_set_active)
+    if (!pimpl->tcmoe_cb_data.empty()) {
+        for (int l = 0; l < n_layer; ++l) {
+            ggml_tensor * tg = layers[l].ffn_gate_exps;
+            ggml_tensor * tu = layers[l].ffn_up_exps;
+            ggml_tensor * td = layers[l].ffn_down_exps;
+            if (tg == nullptr || tu == nullptr || td == nullptr) {
+                throw std::runtime_error(format("tcmoe: layer %d has no routed experts for tcmoe.cb", l));
+            }
+            if (tg->type != GGML_TYPE_TCMOE_Q2NL || tu->type != GGML_TYPE_TCMOE_Q2NL || td->type != GGML_TYPE_TCMOE_Q2NL) {
+                throw std::runtime_error(format("tcmoe: layer %d experts are not tcmoe_q2nl", l));
+            }
+            const float * cb = pimpl->tcmoe_cb_data.data() + (size_t) l * 12;
+            tg->extra = (void *) (cb + 0);
+            tu->extra = (void *) (cb + 4);
+            td->extra = (void *) (cb + 8);
+        }
+    }
+
+    this->tcmoe_domains = domains;
+
+    LLAMA_LOG_INFO("%s: tcmoe: %d domains, %zu patch tensors, %zu expert id tables\n",
+            __func__, n_domain, n_patch, n_table);
+
+    return true;
+}
