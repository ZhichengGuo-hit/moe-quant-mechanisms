+static int tcmoe_q2nl_use_fp32(void) {
+    static int flag = -1;
+    if (flag < 0) {
+        const char * e = getenv("GGML_TCMOE_Q2NL_FP32");
+        flag = (e != NULL && e[0] == '1') ? 1 : 0;
+    }
+    return flag;
+}
+#endif
