+void ggml_cpu_tcmoe_q2nl_set_active(const float * cb4) {
+    if (cb4 == NULL) {
+        cb4 = GGML_TCMOE_Q2NL_UNIFORM;
+    }
+    if (cb4 == GGML_TCMOE_Q2NL_SRC) {
+        return;
+    }
+    GGML_TCMOE_Q2NL_SRC = cb4;
+
+    float amax = 0.0f;
+    for (int i = 0; i < 4; ++i) {
+        GGML_TCMOE_Q2NL_CB.f[i] = cb4[i];
+        const float a = fabsf(cb4[i]);
+        if (a > amax) {
+            amax = a;
+        }
+    }
+    const float scale = amax > 0.0f ? amax / 127.0f : 1.0f;
+    for (int i = 0; i < 4; ++i) {
+        GGML_TCMOE_Q2NL_CB.q8[i] = (int8_t) (GGML_TCMOE_Q2NL_CB.f[i] / scale + (GGML_TCMOE_Q2NL_CB.f[i] >= 0.0f ? 0.5f : -0.5f));
+    }
+    GGML_TCMOE_Q2NL_CB.scale = scale;
+}
