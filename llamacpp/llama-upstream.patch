+        // E-R2: 记住每层 MoE 路由概率张量，图算完后统一读回（不启用 cb_eval）
+        if (moe_dump_enabled && il >= 0 && strcmp(name, "ffn_moe_probs") == 0) {
+            // 标记为输出，防止调度器在 top-k 之后复用该张量的缓冲区
+            ggml_set_output(cur);
+            moe_probs.emplace_back(il, cur);
