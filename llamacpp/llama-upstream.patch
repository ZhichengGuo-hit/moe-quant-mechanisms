+void llama_context::moe_dump_flush(const llama_ubatch & ubatch) {
+    if (!moe_dump_enabled || moe_probs.empty()) {
+        return;
+    }
+    if (moe_dump_f == nullptr) {
+        moe_dump_f = std::fopen(moe_dump_path.c_str(), "wb");
+        if (moe_dump_f == nullptr) {
+            LLAMA_LOG_ERROR("%s: cannot open %s\n", __func__, moe_dump_path.c_str());
+            moe_dump_enabled = false;
+            return;
+        }
+    }
+    ggml_backend_sched_synchronize(sched.get());
+
+    int32_t magic = 0x52544431; // 'RTD1'
+    int32_t n_tok = (int32_t) ubatch.n_tokens;
+    int32_t n_ent = (int32_t) moe_probs.size();
+    std::fwrite(&magic, sizeof(magic), 1, moe_dump_f);
+    std::fwrite(&n_tok, sizeof(n_tok), 1, moe_dump_f);
+    std::fwrite(ubatch.token, sizeof(llama_token), (size_t) n_tok, moe_dump_f);
+    std::fwrite(&n_ent, sizeof(n_ent), 1, moe_dump_f);
+
+    std::vector<float> buf;
+    for (const auto & e : moe_probs) {
+        int32_t il  = e.first;
+        int32_t ne0 = (int32_t) e.second->ne[0];
+        int32_t ne1 = (int32_t) e.second->ne[1];
+        const size_t n = (size_t) ne0 * (size_t) ne1;
+        std::fwrite(&il, sizeof(il), 1, moe_dump_f);
+        std::fwrite(&ne0, sizeof(ne0), 1, moe_dump_f);
+        std::fwrite(&ne1, sizeof(ne1), 1, moe_dump_f);
+        buf.resize(n);
+        if (e.second->type == GGML_TYPE_F32) {
+            ggml_backend_tensor_get(e.second, buf.data(), 0, n * sizeof(float));
+        } else if (e.second->type == GGML_TYPE_F16) {
+            std::vector<ggml_fp16_t> tmp(n);
+            ggml_backend_tensor_get(e.second, tmp.data(), 0, n * sizeof(ggml_fp16_t));
+            for (size_t i = 0; i < n; i++) {
+                buf[i] = ggml_fp16_to_fp32(tmp[i]);
+            }
+        } else {
+            LLAMA_LOG_ERROR("%s: unsupported type %s\n", __func__, ggml_type_name(e.second->type));
+            std::fill(buf.begin(), buf.end(), 0.0f);
+        }
+        std::fwrite(buf.data(), sizeof(float), n, moe_dump_f);
+    }
+    std::fflush(moe_dump_f);
+}
